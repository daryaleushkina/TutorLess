{
  "sign-in": {
    "$type": "color",
    "apple": {
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0,
            0.0,
            0.0
          ],
          "hex": "#000000"
        }
      },
      "text": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            1.0,
            1.0
          ],
          "hex": "#FFFFFF"
        }
      },
      "font-family": {
        "$type": "fontFamily",
        "$value": "{font.family.system}",
        "$description": "Системный шрифт платформы для кнопки Apple; на Android — Roboto."
      },
      "font-size": {
        "$type": "dimension",
        "$value": {
          "value": 17,
          "unit": "px"
        },
        "$description": "Размер текста кнопки Apple."
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Средний вес текста кнопки Apple."
      },
      "line-height": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": "Межстрочное расстояние кнопки Apple."
      }
    },
    "google": {
      "bg": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            1.0,
            1.0,
            1.0
          ],
          "hex": "#FFFFFF"
        }
      },
      "stroke": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.4549,
            0.4667,
            0.4588
          ],
          "hex": "#747775"
        }
      },
      "text": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1216,
            0.1216,
            0.1216
          ],
          "hex": "#1F1F1F"
        }
      },
      "font-family": {
        "$type": "fontFamily",
        "$value": [
          "Roboto",
          "sans-serif"
        ],
        "$description": "Шрифт кнопки Google по правилам Google."
      },
      "font-size": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$description": "Размер текста кнопки Google."
      },
      "font-weight": {
        "$type": "fontWeight",
        "$value": 500,
        "$description": "Roboto Medium для кнопки Google."
      },
      "tracking": {
        "$type": "dimension",
        "$value": {
          "value": 0.25,
          "unit": "px"
        },
        "$description": "Разрядка текста кнопки Google."
      },
      "line-height": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": "Межстрочное расстояние кнопки Google."
      }
    }
  }
}
